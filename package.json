{
  "name": "brioso",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "functions"
  ],
  "scripts": {
    "dev": "node scripts/ensure-husky.mjs && concurrently \"vite --open\" \"firebase emulators:start\" \"yarn workspace functions watch\"",
    "build": "tsc && vite build",
    "lint": "yarn oxlint --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt --write",
    "type-check": "tsc --pretty --noEmit",
    "preview": "vite preview",
    "test": "node scripts/ensure-husky.mjs && vitest run",
    "plugin": "echo \"plugin dummy\"",
    "prepare": "husky",
    "setup:hooks": "node scripts/ensure-husky.mjs",
    "format:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit"
  },
  "lint-staged": {
    "*.@(ts|tsx|mts|js|jsx|mjs|cjs)": [
      "oxlint --fix --deny-warnings --report-unused-disable-directives",
      "oxfmt --write"
    ],
    "*.@(json|jsonc|json5|md|mdx|yaml|yml|css|scss|sass|html|toml)": "oxfmt --write",
    ".github/workflows/*.@(yml|yaml)": "actionlint"
  },
  "dependencies": {
    "@react-spring/web": "^9.6.1",
    "@reduxjs/toolkit": "^1.9.5",
    "classnames": "^2.3.2",
    "firebase": "^9.22.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^11.4.2",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.11.2",
    "reactfire": "^4.2.2",
    "vite-plugin-svgr": "^2.4.0",
    "web-vitals": "^3.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@types/testing-library__jest-dom": "^5",
    "@typescript/native-preview": "^7.0.0-dev.20260504.1",
    "@vitejs/plugin-react-swc": "^3.0.0",
    "concurrently": "^8.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "happy-dom": "^20.9.0",
    "husky": "9",
    "lint-staged": "=13.2.1",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "sass": "^1.62.1",
    "typescript": "^5.0.4",
    "vite": "^7",
    "vitest": "^4.1.5"
  },
  "packageManager": "yarn@4.14.1",
  "dependenciesMeta": {
    "@swc/core": {
      "built": true
    },
    "esbuild": {
      "built": true
    }
  }
}
